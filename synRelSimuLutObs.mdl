__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_60.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="60">
  <P Name="name">Flux_observer2/FluxDerivativeDq</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">60</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">19</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">7</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">flux_observer</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">60</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [lambda_dq, lambda_ab, z_dot_ab, p_dot] = flux_observer(vdq, idq, theta_e, omega_e, R, harmonics, gamma, Ts, z_ab, p)
%#codegen
% Inputs:
%   vdq        : Stator voltage vector [vd; vq] (V)
%   idq        : Stator current vector [id; iq] (A)
%   theta_e    : Electrical angle (rad)
%   omega_e    : Electrical angular speed (rad/s)
%   R          : Stator resistance (Ohm)
%   harmonics  : Row or column vector of harmonic orders K
%   gamma      : Adaptation gain
%   z_ab       : Faraday integral state vector [z_alpha; z_beta] (Wb)
%   p      	: Real parameter state vector [p_real; p_imag] (2*n x 1)
%
% Outputs:
%   lambda_dq : Estimated flux vector in dq frame (Wb)
%   lambda_ab : Estimated flux vector in alpha-beta frame (Wb)
%   z_dot_ab   : Time derivative of Faraday state [dz_alpha; dz_beta] (V)
%   p_dot  : Time derivative of parameter state (2*n x 1)

    num_params = 1 + length(harmonics);

    %% 1. State vector unpacking
    p_real = p(1:num_params);
    p_imag = p(num_params + 1 : 2 * num_params);

    lambda_0_alpha = p_real(1);
    lambda_0_beta  = p_imag(1);
    chi_r = p_real(2:end);
    chi_i = p_imag(2:end);

    %% 2. Output flux reconstruction at t_k (using synchronous theta_e)
    lambda_alpha = z_ab(1) + lambda_0_alpha;
    lambda_beta  = z_ab(2) + lambda_0_beta;
    lambda_ab = [lambda_alpha; lambda_beta];

    cos_th = cos(theta_e);
    sin_th = sin(theta_e);
    lambda_d =  cos_th * lambda_alpha + sin_th * lambda_beta;
    lambda_q = -sin_th * lambda_alpha + cos_th * lambda_beta;
    lambda_dq = [lambda_d; lambda_q];

    %% 3. Faraday derivative with midpoint angle (RK2 integration over Ts)
    theta_e_mid = mod(theta_e + 0.5 * Ts * omega_e, 2.0 * pi);
    cos_mid = cos(theta_e_mid);
    sin_mid = sin(theta_e_mid);

    u_alpha = cos_mid * vdq(1) - sin_mid * vdq(2);
    u_beta  = sin_mid * vdq(1) + cos_mid * vdq(2);
    i_alpha = cos_mid * idq(1) - sin_mid * idq(2);
    i_beta  = sin_mid * idq(1) + cos_mid * idq(2);

    z_dot_ab = [u_alpha - R * i_alpha; ...
                u_beta  - R * i_beta];

    %% 4. Regressor and error at t_k
    cos_kh = cos(harmonics * theta_e);
    sin_kh = sin(harmonics * theta_e);

    z_alpha = -lambda_0_alpha + (cos_kh.&apos; * chi_r - sin_kh.&apos; * chi_i);
    z_beta  = -lambda_0_beta  + (sin_kh.&apos; * chi_r + cos_kh.&apos; * chi_i);

    err_alpha = z_ab(1) - z_alpha;
    err_beta  = z_ab(2) - z_beta;

    %% 5. Adaptation dynamics
    kappa = omega_e * gamma;
    dot_lambda_0_alpha = -kappa * err_alpha;
    dot_lambda_0_beta  = -kappa * err_beta;
    dot_chi_r = kappa * ( cos_kh * err_alpha + sin_kh * err_beta);
    dot_chi_i = kappa * (-sin_kh * err_alpha + cos_kh * err_beta);

    p_dot = [dot_lambda_0_alpha; dot_chi_r; ...
                 dot_lambda_0_beta;  dot_chi_i];
end</P>
      </eml>
    </state>
    <data SSID="13" name="lambda_dq">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="14" name="lambda_ab">
