__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_53.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="53">
  <P Name="name">Flux_observer/Observer</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">53</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">25</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">7</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">flux_observer</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">53</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [lambda, lambda_dq, z_ab] = flux_observer(v, i, theta_e, omega_e, R, harmonics, gamma, Ts)
	persistent p z
    if isempty(p)
        p = complex(zeros(1 + numel(harmonics), 1));
        z = 0 + 0j;
    end
    % Force harmonics regressor into a column vector
    h = harmonics(:);
    phi = exp(1j * h * theta_e);

    lambda_0 = p(1);
    chi = p(2:end);

    %% 1. Faraday derivative &amp; flux reconstruction
    z_dot = v - R * i;
    lambda = z + lambda_0;

    %% 2. Regressor and observation error
    z_est = -lambda_0 + sum(phi .* chi);
    err = z - z_est;

    %% 3. Adaptation dynamics
    kappa = omega_e * gamma;
    dot_lambda_0 = -kappa * err;
    dot_chi      =  kappa * conj(phi) * err;

    p_dot = [dot_lambda_0; dot_chi];

    p = p + Ts * p_dot;
    z = z + Ts * z_dot;
    lambda_dq = lambda * exp(-1j * theta_e);

   z_ab = z;
end</P>
      </eml>
    </state>
    <data SSID="14" name="lambda">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="4" name="v">
