__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_27.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="27">
  <P Name="name">Flux_observer_offset/Observer</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">27</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">25</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">flux_offset_observer</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">27</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [lambda, lambda_dq, d0_est, z_ab] = flux_offset_observer(v, i, theta_e, omega_e, R, harmonics, gamma, Ts)
%#codegen    
    persistent p r z tau N_ls E_ls theta_cum
    if isempty(p)
        n_states = 1 + numel(harmonics);
        p    = complex(zeros(n_states, 1));
        r    = complex(zeros(n_states, 1));
        z    = 0 + 0j;
        tau  = 0;
        N_ls = 0 + 0j;
        E_ls = 0;
        theta_cum = 0;
    end

    h   = harmonics(:);
    phi = exp(1j * h * theta_e);

    %% Prediction errors
    z_est   = -p(1) + sum(phi .* p(2:end));
    e_z     = z - z_est;

    tau_est = -r(1) + sum(phi .* r(2:end));
    e_tau   = tau - tau_est;

    %% Estimation of offset d0
    if theta_cum &gt; (4 * pi) % (Remark 6.12b)
        N_ls = N_ls + Ts * omega_e * (conj(e_tau) * e_z);
        E_ls = E_ls + Ts * omega_e * (abs(e_tau)^2);
        % mu_forget = 10.0; % Exponential forgetting factor [rad/s or 1/s] (Remark 6.12c)
        % N_ls = (1 - Ts * mu_forget) * N_ls + Ts * omega_e * (conj(e_tau) * e_z);
        % E_ls = (1 - Ts * mu_forget) * E_ls + Ts * omega_e * (abs(e_tau)^2);
    end

    if theta_cum &gt; (5 * pi) &amp;&amp; E_ls &gt; 1e-8
        d0_est = N_ls / E_ls;
    else
        d0_est = 0 + 0j;
    end

    %% Flux reconstruction
    lambda    = z - d0_est * tau + p(1) - d0_est * r(1);
    lambda_dq = lambda * exp(-1j * theta_e);

    %% Dynamics
    kappa = omega_e * gamma;
    
    p_dot = [-kappa * e_z;   kappa * conj(phi) * e_z];
    r_dot = [-kappa * e_tau; kappa * conj(phi) * e_tau];
    z_dot = v - R * i;
    
    %-- Integration (Euler)
    p      = p      + Ts * p_dot;
    r      = r      + Ts * r_dot;
    z      = z      + Ts * z_dot;
    tau    = tau    + Ts * 1.0;
    theta_cum = theta_cum + Ts * omega_e;

    z_ab = z;
end</P>
      </eml>
    </state>
    <data SSID="14" name="lambda">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="4" name="v">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="i">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="theta_e">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
