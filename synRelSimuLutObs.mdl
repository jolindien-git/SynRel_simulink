<?xml version="1.0" encoding="utf-8"?>
<chart id="36">
  <P Name="name">Flux_observer_extended/FluxDerivativeDq</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">36</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">24</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">5</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">flux_observer_extended</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">36</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [lambda_dq, lambda_ab, z_dot_ab, p_dot, S_dot_ab, delta_R] = flux_observer_extended(vdq, idq, theta_e, omega_e, R, harmonics, gamma, gamma_R, Ts, z_ab, p, S_ab, time)
%#codegen
% FLUX_OBSERVER_EXTENDED Stator flux and resistance error online observer (Section 6.5).
%
% Inputs:
%   vdq         : Stator voltage vector in dq frame [vd; vq] (V)
%   idq         : Stator current vector in dq frame [id; iq] (A)
%   theta_e     : Electrical angle (rad)
%   omega_e     : Electrical angular speed (rad/s)
%   R           : Nominal stator resistance (Ohm)
%   harmonics   : Vector of odd harmonic orders K
%   gamma       : Flux adaptation gain Gamma (rad^-1)
%   gamma_R     : Minimum energy threshold E_min on E to enable delta_R (Wb^2*rad)
%   Ts          : Sample time (s)
%   z_ab        : Faraday integral state vector [z_alpha; z_beta] (Wb)
%   p           : Extended state vector (4*n + 2 x 1): [p_real; p_imag; r_real; r_imag; N; E]
%   S_ab        : Current integral state vector [S_alpha; S_beta] (A*s)
%
% Outputs:
%   lambda_dq   : Estimated flux vector in dq frame (Wb)
%   lambda_ab   : Estimated flux vector in alpha-beta frame (Wb)
%   z_dot_ab    : Time derivative of Faraday state [dz_alpha; dz_beta] (V)
%   p_dot       : Time derivative of extended parameter state (4*n + 2 x 1)
%   S_dot_ab    : Time derivative of current integral state [dS_alpha; dS_beta] (A)
%   delta_R     : Estimated resistance error (Ohm)

    harmonics = double(harmonics(:));
    num_harmonics = length(harmonics);
    num_params = 1 + num_harmonics;

    %% 1. State vector unpacking (Dimension: 4*n + 2)
    p_real = p(1 : num_params);
    p_imag = p(num_params + 1 : 2 * num_params);
    r_real = p(2 * num_params + 1 : 3 * num_params);
    r_imag = p(3 * num_params + 1 : 4 * num_params);
    N_val  = p(4 * num_params + 1);
    E_val  = p(4 * num_params + 2);

    p0_alpha = p_real(1);
    p0_beta  = p_imag(1);
    chi_p_r  = p_real(2:end);
    chi_p_i  = p_imag(2:end);

    r0_alpha = r_real(1);
    r0_beta  = r_imag(1);
    chi_r_r  = r_real(2:end);
    chi_r_i  = r_imag(2:end);

    %% 2. Output resistance and flux reconstruction at t_k (Eq. 6.17)
    if E_val &gt; gamma_R
        delta_R = N_val / E_val;
    else
        delta_R = 0.0;
    end

    lambda_alpha = z_ab(1) - delta_R * S_ab(1) + p0_alpha - delta_R * r0_alpha;
    lambda_beta  = z_ab(2) - delta_R * S_ab(2) + p0_beta  - delta_R * r0_beta;
    lambda_ab = [lambda_alpha; lambda_beta];

    cos_th = cos(theta_e);
    sin_th = sin(theta_e);
    lambda_d =  cos_th * lambda_alpha + sin_th * lambda_beta;
    lambda_q = -sin_th * lambda_alpha + cos_th * lambda_beta;
    lambda_dq = [lambda_d; lambda_q];

    %% 3. Derivatives with midpoint angle (RK2 integration over Ts)
    theta_e_mid = mod(theta_e + 0.5 * Ts * omega_e, 2.0 * pi);
    cos_mid = cos(theta_e_mid);
    sin_mid = sin(theta_e_mid);

    u_alpha = cos_mid * vdq(1) - sin_mid * vdq(2);
    u_beta  = sin_mid * vdq(1) + cos_mid * vdq(2);
    i_alpha = cos_mid * idq(1) - sin_mid * idq(2);
    i_beta  = sin_mid * idq(1) + cos_mid * idq(2);

    z_dot_ab = [u_alpha - R * i_alpha; ...
                u_beta  - R * i_beta];

    S_dot_ab = [i_alpha; ...
                i_beta];

    %% 4. Regressors and prediction errors at t_k (Eq. 6.14 &amp; 6.15)
    cos_kh = cos(harmonics * theta_e);
    sin_kh = sin(harmonics * theta_e);

    % Copy 1: Prediction of z_R
    z_hat_alpha = -p0_alpha + (cos_kh.&apos; * chi_p_r - sin_kh.&apos; * chi_p_i);
    z_hat_beta  = -p0_beta  + (sin_kh.&apos; * chi_p_r + cos_kh.&apos; * chi_p_i);
    ez_alpha = z_ab(1) - z_hat_alpha;
    ez_beta  = z_ab(2) - z_hat_beta;

    % Copy 2: Prediction of S
    S_hat_alpha = -r0_alpha + (cos_kh.&apos; * chi_r_r - sin_kh.&apos; * chi_r_i);
    S_hat_beta  = -r0_beta  + (sin_kh.&apos; * chi_r_r + cos_kh.&apos; * chi_r_i);
    eS_alpha = S_ab(1) - S_hat_alpha;
    eS_beta  = S_ab(2) - S_hat_beta;

    %% 5. Adaptation dynamics (Eq. 6.14, 6.15 &amp; 6.16 in time variable)
    kappa = omega_e * gamma;

    % Dynamics for p_hat
    dot_p0_alpha = -kappa * ez_alpha;
    dot_p0_beta  = -kappa * ez_beta;
    dot_chi_p_r  =  kappa * ( cos_kh * ez_alpha + sin_kh * ez_beta);
    dot_chi_p_i  =  kappa * (-sin_kh * ez_alpha + cos_kh * ez_beta);

    % Dynamics for r_hat
    dot_r0_alpha = -kappa * eS_alpha;
    dot_r0_beta  = -kappa * eS_beta;
    dot_chi_r_r  =  kappa * ( cos_kh * eS_alpha + sin_kh * eS_beta);
    dot_chi_r_i  =  kappa * (-sin_kh * eS_alpha + cos_kh * eS_beta);

    % Scalar least-squares integrators N and E
    if time &gt; 0.5
        dot_N = omega_e * (eS_alpha * ez_alpha + eS_beta * ez_beta);
        dot_E = omega_e * (eS_alpha^2 + eS_beta^2);
    else
        dot_N = 0;
        dot_E = 0;
    end

    p_dot = [dot_p0_alpha; dot_chi_p_r; ...
             dot_p0_beta;  dot_chi_p_i; ...
             dot_r0_alpha; dot_chi_r_r; ...
             dot_r0_beta;  dot_chi_r_i; ...
             dot_N; ...
             dot_E];
end</P>
      </eml>
    </state>
    <data SSID="13" name="lambda_dq">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="14" name="lambda_ab">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="4" name="vdq">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">2</P>
        </array>
